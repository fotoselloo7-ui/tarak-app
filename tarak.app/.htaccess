# Tarak — public_html/.htaccess  (Apache 2.4 / LiteSpeed on cPanel)
#
#   /                 -> index.html (React SPA, built by Vite)
#   /api/*, /up       -> index.php (bridge) -> ../tarak-backend (Laravel)
#   /payment-result/* -> index.php (PayTR return pages)
#   /storage/*        -> symlink created by `php artisan storage:link` (user uploads: avatars, covers, gallery)
#   /demo-media/*     -> real files (the demo photos); no symlink involved
#   any other path    -> index.html (client-side routes: /legal/privacy, /admin, ...)
#
# cPanel may append its own "php -- BEGIN cPanel-generated handler" block to this file when you change the PHP
# version in MultiPHP Manager. Leave that block alone.

DirectoryIndex index.html

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    # the SPA entry point must never be cached, otherwise users keep an old build after a deploy
    <Files "index.html">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

# Vite output is content-hashed (assets/*.js|css), images change rarely
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType image/x-icon "access plus 7 days"
    ExpiresByType image/vnd.microsoft.icon "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS only (also honours a TLS-terminating proxy; leaves the AutoSSL / Let's Encrypt validation path alone)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # dotfiles are never served (.env, .git, ...), except /.well-known/ (certificate validation)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # keep the Authorization header (Sanctum bearer tokens) on CGI / FastCGI
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # API, health check and PayTR return pages -> Laravel through the bridge index.php
    RewriteRule ^(api|up|payment-result)(/|$) index.php [L]

    # real files and folders (index.html, assets/, brand/, storage/ symlink, ...) are served as they are
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # a missing build asset or upload is a 404, not the SPA page (a stale chunk must not parse as JavaScript)
    RewriteRule ^(assets|storage|demo-media)/ - [R=404,L]

    # everything else is a client-side route of the SPA
    RewriteRule ^ index.html [L]
</IfModule>
