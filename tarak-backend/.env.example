APP_NAME=BerberimGelsin
# Production: set APP_ENV=production, APP_DEBUG=false, and HTTPS APP_URL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://127.0.0.1:8000

# CORS & Stateful domains: in production, set to exact frontend HTTPS domain(s) without trailing slash, NO wildcard (*)
FRONTEND_URL=http://127.0.0.1:8030,http://localhost:8030
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8030,localhost:8030

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=berberimgelsin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Queue: In production use 'database' or 'redis', NEVER 'sync'. Worker: php artisan queue:work --queue=push,default
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PayTR Gateway Credentials (Live production: PAYTR_TEST_MODE=0, PAYTR_DEBUG_ON=0)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_DEBUG_ON=1
PAYTR_IFRAME_V2=1
PAYTR_OK_URL=http://localhost:8030/payment-result/success
PAYTR_FAIL_URL=http://localhost:8030/payment-result/fail

# Laravel Reverb (Production: REVERB_SCHEME=https (wss client), REVERB_PORT=443 behind reverse proxy, NO wildcard in REVERB_ALLOWED_ORIGINS)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http

REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
REVERB_ALLOWED_ORIGINS=127.0.0.1,localhost

CHAT_AFTER_COMPLETION_HOURS=72

# Firebase Cloud Messaging HTTP v1 Backend (Set FCM_ENABLED=true in production with service-account credentials JSON)
FCM_ENABLED=false
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

