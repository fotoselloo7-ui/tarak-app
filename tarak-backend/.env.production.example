# ══════════════════════════════════════════════════════════════════════════════
# Tarak — Laravel backend, PRODUCTION environment template
#
# Copy to  <server>/backend/.env  and fill in the blanks. Do NOT commit the filled file.
# Nothing in here is a real secret: every credential is a blank or a placeholder.
# Check the result on the server with:   php artisan app:production-check
# cPanel package (tarak-cpanel-release.zip): follow INSTALL_CPANEL.md in the zip root. VPS: PRODUCTION_DEPLOYMENT.md.
# Domain used below is tarak.app — replace it everywhere if yours differs.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Tarak
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tarak.app
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Generate ONCE on the server:  php artisan key:generate --show   → paste here.
# NEVER change it after go-live: admin-panel integration secrets (PayTR / SMS / SMTP) are encrypted with it.
APP_KEY=

# cPanel only: absolute path of the document root. `php artisan storage:link` then creates <this>/storage
# (public uploads: avatars, covers, gallery, branding) inside the document root. Example: /home/alac6yazilimtr/tarak.app
# Leave empty on a VPS where backend/public (or an nginx alias) is the web root.
PUBLIC_WEB_ROOT=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ── Web origin (SPA and API share ONE origin: https://tarak.app/ + https://tarak.app/api) ──
# Exact HTTPS origin(s), comma separated, no trailing slash, NO wildcard.
FRONTEND_URL=https://tarak.app
SANCTUM_STATEFUL_DOMAINS=tarak.app

# ── Database (MySQL 8 / MariaDB 10.6+) ────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Session / cache / queue (database drivers need no extra service; Redis is optional) ──
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
CACHE_PREFIX=tarak
# NEVER "sync" in production. Worker: php artisan queue:work --queue=push,default  (see deploy/supervisor-tarak.conf.example)
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ── Realtime (Laravel Reverb behind the web server: wss://tarak.app/app/<key>) ─
# VPS: Reverb listens on 127.0.0.1:8081; the web server proxies /app and /apps to it (deploy/nginx-tarak.conf.example)
#      and BROADCAST_CONNECTION=reverb.
# cPanel / shared hosting CANNOT run Reverb (no long-running process, no websocket proxy): keep BROADCAST_CONNECTION=null.
#      Everything else works; chat messages and notifications just do not arrive instantly (they show when the screen is
#      opened or refreshed). Broadcast failures never break a request (they are caught and logged).
BROADCAST_CONNECTION=null
REVERB_APP_ID=
# Public identifier; must equal VITE_REVERB_APP_KEY of the web build and --dart-define=REVERB_APP_KEY of the apps.
# The delivered web build (dist/) has hhyfpgfv2dgv95yd78kz baked in; use that value or rebuild the web with your own.
REVERB_APP_KEY=hhyfpgfv2dgv95yd78kz
# SECRET — generate a fresh random string (e.g. php -r "echo bin2hex(random_bytes(20));")
REVERB_APP_SECRET=
REVERB_HOST=tarak.app
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
# Browser origins (host names only). The native mobile apps open the websocket WITHOUT an Origin header,
# so a strict list rejects them — see PRODUCTION_DEPLOYMENT.md "Reverb ve mobil uygulama" for the decision.
# `app:production-check` FAILS if this list contains "*".
REVERB_ALLOWED_ORIGINS=tarak.app
CHAT_AFTER_COMPLETION_HOURS=72

# ── Mail (SMTP). Can also be entered later in Admin → Entegrasyon Merkezi → SMTP (DB value wins over .env) ──
MAIL_MAILER=smtp
# smtps = implicit TLS (port 465); leave empty for STARTTLS (port 587)
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ── PayTR (credentials from the PayTR merchant panel; can also be entered in Admin → Entegrasyon Merkezi → PayTR) ──
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Go live ONLY after a successful test-mode run: 0 / 0
PAYTR_TEST_MODE=1
PAYTR_DEBUG_ON=0
PAYTR_IFRAME_V2=1
PAYTR_OK_URL=https://tarak.app/payment-result/success
PAYTR_FAIL_URL=https://tarak.app/payment-result/fail
# PayTR panel → "Bildirim URL":  https://tarak.app/api/payments/paytr/callback
#                (platform transfers):  https://tarak.app/api/payments/paytr/platform-transfer/callback

# ── SMS (Netgsm / VatanSMS) ───────────────────────────────────────────────────
# No .env keys exist for SMS: provider, username, password, sender title and per-event switches live ONLY in
# Admin → Entegrasyon Merkezi → SMS (stored encrypted in the database). Nothing to set here.

# ── Push notifications (Firebase Cloud Messaging HTTP v1) ─────────────────────
FCM_ENABLED=false
FCM_PROJECT_ID=
# Absolute path to the service-account JSON, OUTSIDE the web root and not in version control, chmod 600
GOOGLE_APPLICATION_CREDENTIALS=

# OAuth/OpenID clients registered for this app. Keep Apple client secret on the server only.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_SERVICE_ID=
APPLE_BUNDLE_ID=app.tarak.mobile
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=https://tarak.app/auth/apple/callback

# Google Geocoding API for address search/reverse lookup. Keep on server; restrict to Geocoding API and server IP.
GOOGLE_MAPS_SERVER_KEY=
# Public browser key: restrict by HTTPS referrer to tarak.app and Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
